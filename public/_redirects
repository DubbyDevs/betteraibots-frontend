# Static HTML files are kept as backup, but React app handles all routes to avoid duplicate content
# If you need static HTML for specific crawlers, uncomment and use these redirects:
# /news/trump-ai-action-plan-global-leadership /news/trump-ai-action-plan-global-leadership.html 200
# /news/china-global-ai-cooperation-organization /news/china-global-ai-cooperation-organization.html 200
# /news/openai-gpt5-revolutionary-multimodal-ai /news/openai-gpt5-revolutionary-multimodal-ai.html 200
# /news/google-gemini-pro-100-million-users /news/google-gemini-pro-100-million-users.html 200
# /news/meta-llama-3-open-source-ai /news/meta-llama-3-open-source-ai.html 200
# /news/microsoft-copilot-pro-productivity /news/microsoft-copilot-pro-productivity.html 200
# /news/anthropic-claude-35-sonnet-reasoning /news/anthropic-claude-35-sonnet-reasoning.html 200
# /news/ai-productivity-stack-solo-founders-10-tools-run-business-alone-2025 /news/ai-productivity-stack-solo-founders-10-tools-run-business-alone-2025.html 200

# No service worker — return 404 so no worker is ever registered or updated
/sw.js   404   404

# Escape hatch: serve static clear-cache page so users can break out of old service worker loop.
# Use a path the old SW has never seen (e.g. /reset-app) so it can't return cached index.html.
/clear-cache     /clear-cache.html  200
/fix-mobile      /clear-cache.html  200
/reset-app       /clear-cache.html  200

# --- SEO: one canonical URL per learn article (fixes "alternate page with canonical") ---
/learn/beginner/:id  /learn/:id  301
/learn/intermediate/:id  /learn/:id  301
/learn/advanced/:id  /learn/:id  301

# Learn level listing pages — React app (guides + quizzes UI)
/learn/beginner  /index.html  200
/learn/intermediate  /index.html  200
/learn/advanced  /index.html  200
/learn  /index.html  200

# Learn & news articles — serve pre-rendered HTML with full text for Google + visitors
# (public/learn/*.html and public/news/*.html generated at build time)
/learn/:id  /learn/:id.html  200
/news/:slug  /news/:slug.html  200

# Legacy /sam/* URLs (e.g. sam/box-bold-a-e, sam/boss-bot-*) - not used in this app; redirect to home
/sam/*  /  301

# Legacy /articles/* URLs (e.g. love-doc-ai) - no longer used; redirect to home so GSC stops "Page with redirect"
/articles/love-doc-ai  /  301
/articles/*  /  301

# All other routes go to React app
/*    /index.html   200

# Force HTTPS
http://betteraibots.com/* https://betteraibots.com/:splat 301!

# Handle 404s gracefully
/404 /index.html 200

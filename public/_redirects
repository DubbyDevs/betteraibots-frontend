# Learn routes: serve index.html so the SPA handles /learn/instaglamor etc. (direct links and Google won't 404)
# Prerendered .html files in public/learn are no longer used by redirect; SPA serves all learn pages
/learn/*  /index.html  200

# Legacy /sam/* URLs (e.g. sam/box-bold-a-e, sam/boss-bot-*) - not used in this app; redirect to home
/sam/*  /  301

# Legacy /articles/* URLs (e.g. love-doc-ai) - no longer used; redirect to home so GSC stops "Page with redirect"
/articles/love-doc-ai  /  301
/articles/*  /  301

# All other routes go to React app
/*    /index.html   200

# Force HTTPS
http://betteraibots.com/* https://betteraibots.com/:splat 301!

# Handle 404s gracefully
/404 /index.html 200
